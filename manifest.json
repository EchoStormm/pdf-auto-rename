{
  "manifest_version": 3,
  "name": "PDF AutoRename",
  "version": "0.0.1",
  "description": "Automatically renames PDF files using OpenAI's GPT-4 Vision",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "src/components/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
} 